---
import Base from "../layouts/Base.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Dialogue from "../components/Dialogue.astro";
import Note from "../components/Note.astro";
import CutTo from "../components/CutTo.astro";
import { site } from "../data/site";
---

<Base
  title={`Social media — ${site.name}`}
  description="Alle officiële socialmediakanalen van Mertabi."
  page={3}
>
  <h1 class="slug">Scène 3. Ext. het internet – dag</h1>
  <p class="action">MERTABI staat tussen honderd schermen. Op elk scherm: alleen maar zijn eigen social media.</p>

  <Dialogue>Ja, misschien wel leuk als je me volgt ofzo. Dat kan hier.</Dialogue>

  <h2 class="action cast-title">Rolverdeling</h2>
  <SocialLinks />
  <Note rotate={-4} lift="2.9rem" pointing>Facebook is voor je oom</Note>

  <CutTo href="/contact" label="Contact" />
</Base>
