---
import Base from "../layouts/Base.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Dialogue from "../components/Dialogue.astro";
import Note from "../components/Note.astro";
import CutTo from "../components/CutTo.astro";
import { site } from "../data/site";
---

<Base
  title={`Social media — ${site.name}`}
  description="Alle officiële socialmediakanalen van Mertabi."
  page={3}
>
  <h1 class="slug">Scène 3. Ext. het internet – dag</h1>
  <p class="action">Overal schermen. MERTABI staat in het midden en spreidt de armen.</p>

  <Dialogue>Kom gezellig meedoen. Dit zijn de officiële kanalen van Mertabi.</Dialogue>

  <h2 class="action cast-title">Rolverdeling</h2>
  <SocialLinks />
  <Note rotate={5} lift="6.5rem">volgen is<br />verplicht 😤</Note>

  <CutTo href="/contact" label="Contact" />
</Base>
