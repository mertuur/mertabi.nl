---
import Base from "../layouts/Base.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { site } from "../data/site";
---

<Base title={`Contact | ${site.name}`} description="Neem contact op met Mertabi via mail of social media.">
  <div class="box">
    <h1>Contact met Mertabi</h1>
    <div class="inner">
      <p><b>Mail:</b> <a href={`mailto:${site.email}`}>{site.email}</a> <span class="muted">(stuur een mail)</span></p>
    </div>
  </div>

  <div class="box">
    <h2>Social media</h2>
    <SocialLinks />
  </div>
</Base>
