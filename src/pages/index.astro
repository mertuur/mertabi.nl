---
import Base from "../layouts/Base.astro";
import Player from "../components/Player.astro";
import VideoItem from "../components/VideoItem.astro";
import { site } from "../data/site";
import { getLatestVideos } from "../lib/youtube";
import { cleanTitle } from "../lib/video";

const videos = await getLatestVideos(3);

// Laat Google de nieuwste sketches als video herkennen.
const videoData = videos.map((video) => ({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: cleanTitle(video.title),
  description: `${cleanTitle(video.title)}, een comedy sketch van ${site.name}.`,
  thumbnailUrl: video.thumbnail,
  uploadDate: video.published,
  embedUrl: `https://www.youtube.com/embed/${video.id}`,
  url: `https://www.youtube.com/watch?v=${video.id}`,
  author: { "@id": `${site.url}/#mertabi` },
}));
---

<Base title={`${site.name} | Nederlandse comedy sketches`} description={site.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(videoData)} />
  <div class="welcome">
    <strong>Hoi, leuk dat je er bent.</strong><br />
    Check hier de nieuwste Mertabi sketches. <span class="badge">NIEUW!</span>
  </div>

  {
    videos.length ? (
      <>
        <Player heading="Uitgelichte video" video={videos[0]}>
          <small slot="extra"><a href="/videos">Alle video’s »</a></small>
        </Player>

        <div class="box">
          <h1>
            Nieuwste Mertabi sketches <small>pagina 1 van 1</small>
          </h1>
          {videos.map((video) => (
            <VideoItem video={video} />
          ))}
        </div>
      </>
    ) : (
      <p class="notice">
        De video’s laden even niet. Kijk intussen op{" "}
        <a href={site.youtube.url} target="_blank" rel="noopener noreferrer">YouTube</a>.
      </p>
    )
  }
</Base>
