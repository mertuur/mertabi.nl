---
import Base from "../layouts/Base.astro";
import Player from "../components/Player.astro";
import VideoItem from "../components/VideoItem.astro";
import { site } from "../data/site";
import { getLatestVideos } from "../lib/youtube";

// Alle uploads (met API-key); zonder key geeft de RSS-feed er maximaal 15.
const videos = await getLatestVideos(500);
---

<Base title={`Video's — ${site.name}`} description="De laatste video's van Mertabi op YouTube.">
  <Player heading="Nu aan het kijken" />

  <div class="box">
    <h2>
      <span id="videos-heading">Video’s</span>
      <small id="videos-count">{videos.length} video’s</small>
    </h2>
    <div class="inner intro">Zin in nog meer sketches? Hier kun je er nog een paar checken.</div>

    {
      videos.length ? (
        <>
          <div class="grid" id="video-grid">
            {videos.map((video) => (
              <VideoItem video={video} variant="cell" />
            ))}
          </div>
          <div class="more" id="more" hidden>
            <button type="button">Meer video’s laden…</button>
          </div>
          <p class="inner" id="no-results" hidden>
            Geen sketches gevonden. Probeer een ander woord, of bekijk <a href="/videos">alle video’s</a>.
          </p>
        </>
      ) : (
        <p class="inner">
          Geen video’s kunnen ophalen. Alles staat op{" "}
          <a href={site.youtube.url} target="_blank" rel="noopener noreferrer">youtube.com/mertabi</a>.
        </p>
      )
    }
  </div>
</Base>

<script>
  // Zoeken (/videos?q=osman) en oneindig scrollen: telkens 20 video's erbij zodra je onderaan bent.
  const BATCH = 20;
  const query = new URLSearchParams(location.search).get("q")?.trim().toLowerCase() ?? "";
  const cells = [...document.querySelectorAll<HTMLElement>("#video-grid .cell")];
  const matches = cells.filter((cell) => (cell.dataset.search ?? "").includes(query));
  cells.forEach((cell) => (cell.hidden = true));

  if (query) {
    document.getElementById("videos-heading")!.textContent = `Zoekresultaten voor "${query}"`;
    document.getElementById("no-results")!.hidden = matches.length > 0;
    const input = document.querySelector<HTMLInputElement>(".searchbar input");
    if (input) input.value = query;
  }
  document.getElementById("videos-count")!.textContent = `${matches.length} video’s`;

  const more = document.getElementById("more")!;
  let shown = 0;
  function showMore() {
    matches.slice(shown, shown + BATCH).forEach((cell) => (cell.hidden = false));
    shown = Math.min(shown + BATCH, matches.length);
    more.hidden = shown >= matches.length;
    if (more.hidden) observer.disconnect();
  }

  const observer = new IntersectionObserver(
    (entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      showMore();
      // Opnieuw waarnemen, zodat er nog een rij bijkomt als het einde nog steeds in beeld is.
      if (!more.hidden) {
        observer.unobserve(more);
        observer.observe(more);
      }
    },
    { rootMargin: "400px" },
  );
  more.querySelector("button")!.addEventListener("click", showMore);
  showMore();
  if (!more.hidden) observer.observe(more);
</script>
