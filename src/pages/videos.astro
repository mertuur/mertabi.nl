---
import Base from "../layouts/Base.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import Dialogue from "../components/Dialogue.astro";
import CutTo from "../components/CutTo.astro";
import { site } from "../data/site";
import { getLatestVideos } from "../lib/youtube";

const videos = await getLatestVideos(20);
---

<Base title={`Video's — ${site.name}`} description="De laatste video's van Mertabi op YouTube." page={2}>
  <h1 class="slug">
    Scène 2. Int. <span class="struck">video’s<span class="fix" aria-hidden="true">sketches!!</span></span> – nacht
  </h1>
  <p class="action">MERTABI zet een oude computer aan. De computer klinkt alsof die elk moment uit elkaar kan vallen.</p>

  <Dialogue>Zin in nog meer sketches? Hier kun je er nog een paar checken.</Dialogue>

  {
    videos.length ? (
      <section class="grid" aria-label="Laatste video's">
        {videos.map((video) => (
          <VideoEmbed id={video.id} title={video.title} thumbnail={video.thumbnail} scene={2} />
        ))}
      </section>
    ) : (
      <p class="action">
        (Geen video’s kunnen ophalen. Alles staat op{" "}
        <a href={site.youtube.url} target="_blank" rel="noopener noreferrer">youtube.com/mertabi</a>.)
      </p>
    )
  }

  <CutTo href="/social" label="Social media" />
</Base>
