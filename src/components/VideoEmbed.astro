---
interface Props {
  id: string;
  title: string;
  thumbnail?: string;
  showTitle?: boolean;
}

const { id, title, thumbnail, showTitle = true } = Astro.props;
const image = thumbnail || `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<div class="video-wrap">
  <button class="video-facade" type="button" data-youtube-id={id} aria-label={`Speel ${title}`}>
    <img src={image} alt="" loading="lazy" />
    <span class="play" aria-hidden="true"></span>
    {showTitle && <span class="video-title">{title}</span>}
  </button>
</div>

<script>
  function playVideo(button: HTMLButtonElement) {
    const id = button.dataset.youtubeId;
    if (!id) return;

    const iframe = document.createElement("iframe");
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
    iframe.title = button.getAttribute("aria-label") ?? "YouTube video";
    iframe.allow =
      "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
    iframe.allowFullscreen = true;
    button.replaceWith(iframe);
  }

  document.querySelectorAll<HTMLButtonElement>("[data-youtube-id]").forEach((button) => {
    button.addEventListener("click", () => playVideo(button));
  });
</script>
