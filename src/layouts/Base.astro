---
import "../styles/global.css";
import { site } from "../data/site";
import SocialLinks from "../components/SocialLinks.astro";
import { getChannelViews } from "../lib/youtube";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const views = (await getChannelViews()) ?? site.youtube.totalViews;
const canonical = new URL(currentPath, site.url).href;
const ogImage = new URL("/og-image.png", site.url).href;

// Vertelt Google wie Mertabi is en welke accounts erbij horen.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      name: site.name,
      url: site.url,
      inLanguage: "nl-NL",
      publisher: { "@id": `${site.url}/#mertabi` },
    },
    {
      "@type": "Person",
      "@id": `${site.url}/#mertabi`,
      name: site.name,
      url: site.url,
      image: new URL("/logo.png", site.url).href,
      description: site.description,
      email: site.email,
      sameAs: site.socials.map((social) => social.url),
    },
  ],
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mertabi, Nederlandse comedy sketches" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="head" />
  </head>
  <body>
    <div class="wrap">
      <header class="top">
        <a class="brand" href="/" aria-label={site.name}>
          <span class="word">Mert<span class="box">abi</span></span>
          <span class="slogan">Broadcast je oom™</span>
        </a>
        <div class="account">
          Hallo, <b>SuPeRCarLoVeR911</b>! |
          <a href={`${site.youtube.url}?sub_confirmation=1`} target="_blank" rel="noopener noreferrer">Abonneren</a> |
          <a href="/contact">Contact</a>
          <br />
          <span class="muted">Bezoekersteller:</span> <span class="counter">{views.toLocaleString("nl-NL")}</span>
        </div>
      </header>

      <nav class="tabs" aria-label="Hoofdmenu">
        {
          site.nav.map((item) => (
            <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <form class="searchbar" action="/videos" method="get" role="search">
        <input type="search" name="q" placeholder="Zoek in sketches…" aria-label="Zoek in sketches" />
        <button type="submit">Zoeken</button>
      </form>

      <div class="layout">
        <main>
          <slot />
        </main>

        <aside class="side">
          <div class="box">
            <h2>Kanaal</h2>
            <div class="inner profile">
              <div class="avatar"><img src="/logo-m.png" alt="" /></div>
              <div>
                <a href={site.youtube.url} target="_blank" rel="noopener noreferrer"><b>{site.youtube.handle}</b></a>
                <br />
                <span class="muted">{site.tagline}</span>
                <br />
                <a
                  class="btn-sub"
                  href={`${site.youtube.url}?sub_confirmation=1`}
                  target="_blank"
                  rel="noopener noreferrer">Abonneren</a
                >
              </div>
            </div>
          </div>

          <div class="box">
            <h2>Vrienden</h2>
            <div class="inner">
              <SocialLinks variant="list" />
            </div>
          </div>

          <div class="box">
            <h2>Contact</h2>
            <div class="inner"><a href={`mailto:${site.email}`}>{site.email}</a></div>
          </div>
        </aside>
      </div>

      <footer class="site-footer">
        {
          site.nav.map((item, i) => (
            <>
              {i > 0 && " | "}
              <a href={item.href}>{item.label}</a>
            </>
          ))
        }
        <br />
        {site.name} {new Date().getFullYear()}
      </footer>
    </div>
  </body>
</html>
