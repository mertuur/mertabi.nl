{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.mertabi.nl" }],
      "destination": "https://mertabi.nl/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "mertabi.vercel.app" }],
      "destination": "https://mertabi.nl/$1",
      "permanent": true
    }
  ]
}
